{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChromaQR",
  "version": "0.0.5",
  "identifier": "com.chromaqr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ChromaQR",
        "width": 1150,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Javier Maldonado Hernández",
    "copyright": "Copyright © 2026 Javier Maldonado Hernández",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Fast, lightweight cross-platform QR Code Generator & Designer",
    "longDescription": "ChromaQR is a high-performance desktop QR code studio built with Tauri v2 and Astro, featuring real-time 60fps preview, WCAG contrast scannability validation, custom gradients, embedded logos, and multi-format export.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/com.chromaqr.desktop.metainfo.xml": "../packaging/linux/com.chromaqr.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/com.chromaqr.desktop.metainfo.xml": "../packaging/linux/com.chromaqr.desktop.metainfo.xml"
        }
      }
    }
  }
}
