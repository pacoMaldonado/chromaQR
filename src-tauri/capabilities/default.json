{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Zero-Trust minimal capabilities for ChromaQR: write-only clipboard image, save-only file dialog, and isolated AppData presets",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:scope-appdata-recursive",
    "clipboard-manager:allow-write-image"
  ]
}
