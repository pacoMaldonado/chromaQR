{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Strict minimal capabilities for ChromaQR desktop application (dialog, fs, clipboard-manager)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-app-data-recursive",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text"
  ]
}
