{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Zero-Trust minimal capabilities for ChromaQR Desktop: clipboard image, save dialog, isolated AppData presets, native share, and scoped GitHub URL opener",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:scope-appdata-recursive",
    "clipboard-manager:allow-write-image",
    "vnidrop-share:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/pacoMaldonado/chromaQR" },
        { "url": "https://github.com/pacoMaldonado/chromaQR/**" }
      ]
    }
  ]
}
