---
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
---

<div data-payload-panel="sms" class="hidden space-y-3">
  <div class="grid grid-cols-3 gap-2.5">
    <Select
      id="sms-mode"
      label="Canal de Mensajería"
      value="whatsapp"
      options={[
        { value: 'whatsapp', label: 'WhatsApp (wa.me)' },
        { value: 'sms', label: 'SMS Estándar (SMSTO:)' },
      ]}
    />
    <Input
      id="sms-country"
      label="Código País"
      placeholder="+52"
      value="+52"
      mono={true}
    />
    <Input
      id="sms-phone"
      label="Número Telefónico"
      type="tel"
      placeholder="5512345678"
      value="5512345678"
      mono={true}
      required={true}
    />
  </div>

  <div class="space-y-1.5">
    <label for="sms-message" class="block text-xs font-medium text-app-text">
      Mensaje Prellenado
    </label>
    <textarea
      id="sms-message"
      rows={3}
      placeholder="Escribe el mensaje que aparecerá listo para enviar..."
      class="w-full p-3 rounded-lg bg-app-elevated border border-app-border text-xs text-app-text placeholder:text-zinc-500 font-sans focus-ring resize-none"
    >¡Hola! Escaneé tu código ChromaQR.</textarea>
  </div>
</div>
