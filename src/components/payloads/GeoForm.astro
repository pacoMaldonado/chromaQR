---
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
---

<div data-payload-panel="geo" class="hidden space-y-3">
  <div class="grid grid-cols-3 gap-2.5">
    <Input
      id="geo-lat"
      label="Latitud (-90 a 90)"
      type="text"
      placeholder="19.432608"
      value="19.432608"
      mono={true}
      required={true}
    />
    <Input
      id="geo-lng"
      label="Longitud (-180 a 180)"
      type="text"
      placeholder="-99.133209"
      value="-99.133209"
      mono={true}
      required={true}
    />
    <Select
      id="geo-format"
      label="Formato de Destino"
      value="geo_uri"
      options={[
        { value: 'geo_uri', label: 'Estándar geo:lat,lng' },
        { value: 'google_maps', label: 'Enlace Google Maps' },
      ]}
    />
  </div>

  <Input
    id="geo-query"
    label="Etiqueta o Lugar (Opcional)"
    placeholder="Centro Histórico, Ciudad de México"
    value="Centro Histórico, CDMX"
  />
</div>
