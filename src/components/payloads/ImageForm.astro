---
import { UploadCloud, Cpu } from 'lucide-astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Slider from '../ui/Slider.astro';
---

<div data-payload-panel="image" class="hidden space-y-3.5">
  <Select
    id="img-mode"
    label="Modo de Codificación de Imagen"
    value="offline_base64"
    options={[
      {
        value: 'offline_base64',
        label: 'Modo 1: Offline Data / Base64 (Miniatura embebida en el QR, máx 2,953 bytes)',
      },
      {
        value: 'remote_url',
        label: 'Modo 2: Enlace a Imagen Web (Con previsualización rápida)',
      },
    ]}
  />

  <!-- Modo 1: Offline Data / Base64 -->
  <div id="img-offline-panel" class="space-y-3">
    <div class="p-3 rounded-lg bg-app-elevated/70 border border-app-border space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="inline-flex items-center gap-1.5 font-medium text-app-text">
          <Cpu class="w-3.5 h-3.5 text-app-accent" />
          Capacidad Técnica del Estándar QR (Versión 40-L)
        </span>
        <span id="img-capacity-label" class="font-mono text-[11px] text-app-success">
          382 / 2953 bytes (13%)
        </span>
      </div>
      <div class="w-full h-2 rounded-full bg-app-active overflow-hidden">
        <div
          id="img-capacity-bar"
          class="h-full bg-app-accent transition-all duration-200"
          style="width: 13%;"
        ></div>
      </div>
      <p class="text-[11px] text-app-muted leading-relaxed">
        Un código QR almacena hasta <strong>2,953 bytes</strong> binarios. ChromaQR comprime y escala automáticamente tu imagen en WEBP/SVG para que pueda decodificarse 100% offline.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <label
        for="img-offline-file"
        class="relative flex flex-col items-center justify-center p-3 rounded-xl border border-dashed border-zinc-700 hover:border-app-accent bg-app-elevated/40 hover:bg-app-accent/5 cursor-pointer text-center transition-all"
      >
        <input
          id="img-offline-file"
          type="file"
          accept="image/png,image/jpeg,image/webp,image/svg+xml"
          class="sr-only"
        />
        <UploadCloud class="w-5 h-5 text-app-accent mb-1" />
        <span class="text-xs font-medium text-app-text">Subir imagen local</span>
        <span id="img-offline-filename" class="text-[10px] font-mono text-app-muted mt-0.5 truncate max-w-full">
          chroma-mini-icon.svg
        </span>
      </label>

      <div class="flex flex-col items-center justify-center p-2 rounded-xl bg-checkerboard border border-app-border">
        <img
          id="img-offline-preview"
          src='data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="%2309090B"/><rect x="12" y="12" width="18" height="18" rx="4" fill="%236366F1"/><rect x="34" y="12" width="18" height="18" rx="4" fill="%2310B981"/><rect x="12" y="34" width="18" height="18" rx="4" fill="%2310B981"/><rect x="34" y="34" width="18" height="18" rx="4" fill="%23FAFAFA"/></svg>'
          alt="Vista previa miniatura offline"
          class="w-12 h-12 object-contain rounded border border-app-border"
        />
        <span class="text-[10px] font-mono text-app-muted mt-1">Miniatura embebida</span>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <Slider
        id="img-max-dim"
        label="Resolución Miniatura"
        min={16}
        max={96}
        step={8}
        value={48}
        unit="px"
      />
      <Slider
        id="img-quality"
        label="Calidad WEBP"
        min={20}
        max={95}
        step={5}
        value={65}
        unit="%"
      />
    </div>
  </div>

  <!-- Modo 2: Enlace a Imagen Web -->
  <div id="img-remote-panel" class="hidden space-y-3">
    <Input
      id="img-remote-url"
      label="URL Directa de la Imagen"
      type="url"
      placeholder="https://ejemplo.com/imagen.png"
      value="https://chromaqr.app/favicon.svg"
      mono={true}
    />
    <div class="flex items-center gap-3 p-2.5 rounded-lg bg-app-elevated/60 border border-app-border">
      <img
        id="img-remote-preview"
        src="/favicon.svg"
        alt="Previsualización remota"
        class="w-10 h-10 rounded bg-checkerboard object-contain p-1 border border-app-border"
      />
      <div class="text-[11px] text-app-muted">
        El código QR codificará el enlace directo a la imagen para visualización rápida en alta resolución.
      </div>
    </div>
  </div>
</div>
