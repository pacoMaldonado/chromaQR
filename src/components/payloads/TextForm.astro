---

<div data-payload-panel="text" class="hidden space-y-3">
  <div class="space-y-1.5">
    <div class="flex items-center justify-between">
      <label for="text-input" class="block text-xs font-medium text-app-text">
        Contenido de Texto Plano / Notas (UTF-8) <span class="text-app-accent">*</span>
      </label>
      <span id="text-density-indicator" class="font-mono text-[11px] text-app-success">
        Densidad Óptima
      </span>
    </div>
    <textarea
      id="text-input"
      rows={4}
      placeholder="Escribe cualquier texto, nota, clave pública o fragmento UTF-8..."
      class="w-full p-3 rounded-lg bg-app-elevated border border-app-border text-xs text-app-text placeholder:text-zinc-500 font-sans focus-ring resize-none"
    >ChromaQR — Generador de códigos QR de escritorio ultrarrápido.</textarea>
  </div>
</div>
