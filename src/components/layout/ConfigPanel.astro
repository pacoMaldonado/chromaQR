---
import { Code2, AlertCircle, CheckCircle2 } from 'lucide-astro';
import PayloadTabs from '../payloads/PayloadTabs.astro';
import UrlForm from '../payloads/UrlForm.astro';
import TextForm from '../payloads/TextForm.astro';
import VCardForm from '../payloads/VCardForm.astro';
import WifiForm from '../payloads/WifiForm.astro';
import EmailForm from '../payloads/EmailForm.astro';
import SmsWhatsappForm from '../payloads/SmsWhatsappForm.astro';
import GeoForm from '../payloads/GeoForm.astro';
import CalendarForm from '../payloads/CalendarForm.astro';
import ImageForm from '../payloads/ImageForm.astro';
import DotsAccordion from '../design/DotsAccordion.astro';
import CornersAccordion from '../design/CornersAccordion.astro';
import ColorsAccordion from '../design/ColorsAccordion.astro';
import LogoAccordion from '../design/LogoAccordion.astro';
import TechAccordion from '../design/TechAccordion.astro';
---

<section
  id="config-panel-section"
  class="w-full h-full min-h-0 col-start-1 row-start-2 lg:border-r border-app-border bg-app-bg flex flex-col overflow-hidden"
>
  <!-- Top Bar: QR Payload Type Selector Tabs -->
  <div id="payload-tabs-bar" class="shrink-0">
    <PayloadTabs />
  </div>

  <!-- Scrollable Interior Workspace (No Global Window Scroll) -->
  <div class="flex-1 overflow-y-auto px-3.5 sm:px-5 py-4 space-y-5">
    <!-- Dynamic Payload Data Card -->
    <div id="mobile-section-content" class="rounded-xl bg-app-surface border border-app-border p-3.5 sm:p-4 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-app-border pb-2.5">
        <div>
          <h2 id="payload-section-title" class="text-xs font-semibold uppercase tracking-wider text-app-text">
            Datos del Payload · URL / Sitio Web
          </h2>
          <p id="payload-section-subtitle" class="text-[11px] text-app-muted mt-0.5">
            Enlace web con validación de protocolo HTTPS y limpieza de parámetros UTM
          </p>
        </div>
        <span
          id="payload-byte-counter"
          class="px-2 py-0.5 rounded bg-app-elevated border border-app-border font-mono text-[11px] text-app-muted"
        >
          20 bytes
        </span>
      </div>

      <!-- Dynamic 9 Payload Forms -->
      <div id="payload-forms-wrapper" class="space-y-3">
        <UrlForm />
        <TextForm />
        <VCardForm />
        <WifiForm />
        <EmailForm />
        <SmsWhatsappForm />
        <GeoForm />
        <CalendarForm />
        <ImageForm />
      </div>

      <!-- Validation Error Banner (Hidden when valid) -->
      <div
        id="payload-validation-banner"
        class="hidden items-center gap-2 px-3 py-2 rounded-lg bg-app-danger/10 border border-app-danger/30 text-app-danger text-xs"
      >
        <AlertCircle class="w-4 h-4 shrink-0" />
        <span id="payload-validation-message">Datos de entrada inválidos</span>
      </div>

      <!-- Validation Warning / Info Banner -->
      <div
        id="payload-warning-banner"
        class="hidden items-center gap-2 px-3 py-2 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs"
      >
        <CheckCircle2 class="w-4 h-4 shrink-0 text-amber-400" />
        <span id="payload-warning-message">Aviso técnico</span>
      </div>

      <!-- Raw Encoded String Technical Preview -->
      <div class="pt-2 border-t border-app-border/70">
        <div class="flex items-center justify-between mb-1.5">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-app-muted">
            <Code2 class="w-3.5 h-3.5 text-app-accent" />
            Payload Codificado (Raw String)
          </span>
          <span id="payload-char-count" class="font-mono text-[10px] text-app-muted">20 chars</span>
        </div>
        <pre
          id="raw-payload-preview"
          data-selectable="true"
          class="w-full max-h-20 overflow-y-auto px-3 py-2 rounded-lg bg-app-bg border border-app-border font-mono text-[11px] text-app-text whitespace-pre-wrap break-all"
        >https://chromaqr.app</pre>
      </div>
    </div>

    <!-- Design Customization Accordions Header -->
    <div id="mobile-section-design" class="space-y-2.5">
      <div class="flex items-center justify-between px-0.5">
        <h3 class="text-[11px] font-semibold uppercase tracking-wider text-app-muted">
          Personalización Estética y Óptica
        </h3>
        <span class="font-mono text-[10px] text-app-muted">5 Módulos de Diseño</span>
      </div>

      <DotsAccordion />
      <CornersAccordion />
      <ColorsAccordion />
      <LogoAccordion />
      <TechAccordion />
    </div>
  </div>
</section>
