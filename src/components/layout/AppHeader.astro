---
import { QrCode, RotateCcw, Sun, Moon, Github } from 'lucide-astro';
import Button from '../ui/Button.astro';

const appVersion = __APP_VERSION__;
---

<header class="px-3.5 sm:px-5 pt-safe pb-2.5 border-b border-app-border bg-app-surface flex items-center justify-between gap-2 shrink-0 transition-colors">
  <div class="flex items-center gap-2.5 min-w-0">
    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-app-accent/25 to-app-success/20 border border-app-accent/40 flex items-center justify-center text-app-accent shadow-glow shrink-0">
      <QrCode class="w-4 h-4" />
    </div>
    <div class="min-w-0">
      <div class="flex items-center gap-1.5">
        <h1 class="text-sm font-semibold tracking-tight text-app-text leading-none">ChromaQR</h1>
        <span class="hidden sm:inline-flex px-1.5 py-0.5 rounded bg-app-elevated border border-app-border font-mono text-[10px] text-app-muted">
          PRO STUDIO
        </span>
        <button
          id="app-version-btn"
          type="button"
          data-version={appVersion}
          title={`ChromaQR v${appVersion} — Ver notas de la versión en GitHub`}
          class="px-1.5 py-0.5 rounded bg-app-accent/10 border border-app-accent/30 font-mono text-[10px] text-app-accent hover:bg-app-accent/20 transition-colors cursor-pointer shrink-0"
        >
          v{appVersion}
        </button>
      </div>
      <p class="hidden sm:block text-[11px] text-app-muted mt-0.5 truncate">Generador &amp; Diseñador QR de Alto Rendimiento</p>
    </div>
  </div>

  <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
    <!-- Botón de Cambio de Tema (Claro / Oscuro) -->
    <Button
      id="theme-toggle-btn"
      variant="secondary"
      size="sm"
      class="min-h-[36px] sm:min-h-0"
      title="Cambiar entre Tema Oscuro y Tema Claro"
    >
      <Sun id="theme-icon-sun" class="w-3.5 h-3.5 text-amber-400" />
      <Moon id="theme-icon-moon" class="w-3.5 h-3.5 text-app-accent hidden" />
      <span id="theme-toggle-label" class="hidden sm:inline">Claro</span>
    </Button>

    <!-- Botón Oficial de GitHub -->
    <Button
      id="github-repo-btn"
      variant="secondary"
      size="sm"
      class="min-h-[36px] sm:min-h-0"
      title="Abrir repositorio oficial en GitHub (pacoMaldonado/chromaQR)"
    >
      <Github class="w-3.5 h-3.5" />
      <span class="hidden sm:inline">GitHub</span>
    </Button>

    <!-- Botón de Restablecer -->
    <Button
      id="reset-all-btn"
      variant="ghost"
      size="sm"
      class="min-h-[36px] sm:min-h-0"
      title="Restablecer valores por defecto"
    >
      <RotateCcw class="w-3.5 h-3.5" />
      <span class="hidden sm:inline">Restablecer</span>
    </Button>
  </div>
</header>
