---
interface Props {
  id: string;
  label: string;
  description?: string;
  checked?: boolean;
  class?: string;
}

const {
  id,
  label,
  description,
  checked = false,
  class: className = '',
} = Astro.props;
---

<label
  for={id}
  class:list={[
    'flex items-center justify-between gap-3 p-2.5 rounded-lg bg-app-elevated/60 border border-app-border hover:border-app-muted/40 cursor-pointer transition-colors',
    className,
  ]}
>
  <div class="min-w-0">
    <div class="text-xs font-medium text-app-text">{label}</div>
    {description && (
      <div class="text-[11px] text-app-muted mt-0.5 leading-snug">{description}</div>
    )}
  </div>
  <div class="relative inline-flex items-center shrink-0">
    <input
      id={id}
      type="checkbox"
      checked={checked}
      class="sr-only peer"
    />
    <div class="w-9 h-5 bg-app-active border border-app-border rounded-full peer peer-checked:bg-app-accent peer-checked:border-indigo-400 after:content-[''] after:absolute after:top-[3px] after:left-[3px] after:bg-white after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:after:translate-x-4"></div>
  </div>
</label>
