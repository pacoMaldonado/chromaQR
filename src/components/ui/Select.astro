---
interface OptionItem {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label?: string;
  options: OptionItem[];
  value?: string;
  mono?: boolean;
  class?: string;
}

const {
  id,
  label,
  options,
  value,
  mono = false,
  class: className = '',
} = Astro.props;
---

<div class:list={['space-y-1.5', className]}>
  {label && (
    <label for={id} class="block text-xs font-medium text-app-text">
      {label}
    </label>
  )}
  <select
    id={id}
    name={id}
    class:list={[
      'w-full h-9 px-3 rounded-lg bg-app-elevated border border-app-border text-xs text-app-text transition-colors focus-ring cursor-pointer',
      mono ? 'font-mono' : 'font-sans',
    ]}
  >
    {options.map((opt) => (
      <option value={opt.value} selected={opt.value === value} class="bg-app-surface text-app-text">
        {opt.label}
      </option>
    ))}
  </select>
</div>
