---
import { ChevronDown } from 'lucide-astro';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  badgeText?: string;
  badgeId?: string;
  defaultOpen?: boolean;
}

const {
  id,
  title,
  subtitle,
  badgeText,
  badgeId,
  defaultOpen = false,
} = Astro.props;
---

<div
  class="group rounded-xl bg-app-surface border border-app-border overflow-hidden transition-colors duration-150 hover:border-zinc-700/80"
  data-accordion={id}
  data-open={defaultOpen ? 'true' : 'false'}
>
  <button
    type="button"
    class="w-full px-4 py-3 flex items-center justify-between text-left bg-app-surface hover:bg-app-elevated/60 transition-colors"
    data-accordion-trigger={id}
    aria-expanded={defaultOpen ? 'true' : 'false'}
  >
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-7 h-7 rounded-lg bg-app-elevated border border-app-border flex items-center justify-center text-app-accent shrink-0">
        <slot name="icon" />
      </div>
      <div class="min-w-0">
        <div class="text-xs font-semibold text-app-text tracking-tight truncate">{title}</div>
        {subtitle && (
          <div class="text-[11px] text-app-muted truncate mt-0.5">{subtitle}</div>
        )}
      </div>
    </div>

    <div class="flex items-center gap-2.5 shrink-0">
      {badgeText && (
        <span
          id={badgeId}
          class="px-2 py-0.5 rounded-md bg-app-elevated border border-app-border font-mono text-[10px] text-app-muted"
        >
          {badgeText}
        </span>
      )}
      <ChevronDown
        class={`w-4 h-4 text-app-muted transition-transform duration-200 ${defaultOpen ? 'rotate-180' : ''}`}
        data-accordion-chevron={id}
      />
    </div>
  </button>

  <div
    class={`border-t border-app-border bg-app-bg/40 px-4 py-4 space-y-4 ${defaultOpen ? 'block' : 'hidden'}`}
    data-accordion-content={id}
  >
    <slot />
  </div>
</div>
