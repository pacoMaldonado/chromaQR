---
interface Props {
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'emerald' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  title?: string;
  disabled?: boolean;
  fullWidth?: boolean;
}

const {
  id,
  type = 'button',
  variant = 'secondary',
  size = 'md',
  class: className = '',
  title,
  disabled = false,
  fullWidth = false,
} = Astro.props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  primary:
    'bg-app-accent hover:bg-app-accent-hover text-white border border-indigo-400/20 shadow-sm shadow-indigo-950/50',
  secondary:
    'bg-app-elevated hover:bg-app-active text-app-text border border-app-border',
  emerald:
    'bg-app-success/15 hover:bg-app-success/25 text-app-success border border-app-success/30',
  ghost:
    'bg-transparent hover:bg-app-elevated text-app-muted hover:text-app-text border border-transparent',
  danger:
    'bg-app-danger/15 hover:bg-app-danger/25 text-app-danger border border-app-danger/30',
};

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  sm: 'h-7 px-2.5 text-[11px] rounded-lg gap-1.5',
  md: 'h-9 px-3.5 text-xs rounded-lg gap-2',
  lg: 'h-10 px-4 text-xs rounded-xl gap-2',
};
---

<button
  id={id}
  type={type}
  title={title}
  disabled={disabled}
  class:list={[
    'inline-flex items-center justify-center font-medium transition-all duration-150 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none focus-ring',
    variantClasses[variant],
    sizeClasses[size],
    fullWidth ? 'w-full' : '',
    className,
  ]}
>
  <slot />
</button>
