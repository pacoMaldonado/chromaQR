---
import MainLayout from '../layouts/MainLayout.astro';
import AppHeader from '../components/layout/AppHeader.astro';
import ConfigPanel from '../components/layout/ConfigPanel.astro';
import PreviewPanel from '../components/layout/PreviewPanel.astro';
import MobileBottomNav from '../components/layout/MobileBottomNav.astro';
import Toast from '../components/ui/Toast.astro';
---

<MainLayout title="ChromaQR — Generador y Diseñador QR">
  <main
    id="app-main-shell"
    data-mobile-tab="content"
    class="flex-1 grid grid-cols-1 grid-rows-[auto_1fr_auto] lg:grid-cols-[60%_40%] lg:grid-rows-[auto_1fr] h-[100dvh] w-screen overflow-hidden bg-app-bg"
  >
    <!-- Encabezado (Fila 1 Col 1 en escritorio y móvil) -->
    <div class="col-start-1 row-start-1 lg:border-r lg:border-app-border min-w-0">
      <AppHeader />
    </div>

    <!-- Columna Izquierda (60% en escritorio / Pestañas Contenido y Diseño en móvil) -->
    <ConfigPanel />

    <!-- Columna Derecha (40% en escritorio / Pestaña Vista Previa en móvil) -->
    <PreviewPanel />

    <!-- Barra de Pestañas Inferior (Solo Móvil < 1024px) -->
    <MobileBottomNav />
  </main>

  <!-- Sistema de Notificaciones Flotantes (Toast) -->
  <Toast />

  <script>
    import { initPayloadController } from '../core/payloads/payload-controller';
    import { initDesignController } from '../core/qr/design-controller';
    import { initExportAndPresetController } from '../core/qr/export-preset-controller';

    function initBaseUiInteractions(): void {
      // 1. Accordions toggle behavior
      const triggers = document.querySelectorAll<HTMLButtonElement>('[data-accordion-trigger]');
      triggers.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-accordion-trigger');
          if (!id) return;
          const content = document.querySelector<HTMLElement>(`[data-accordion-content="${id}"]`);
          const chevron = document.querySelector<HTMLElement>(`[data-accordion-chevron="${id}"]`);
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';

          btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
          content?.classList.toggle('hidden', isExpanded);
          content?.classList.toggle('block', !isExpanded);
          chevron?.classList.toggle('rotate-180', !isExpanded);
        });
      });

      // 2. Range Sliders live value badge sync
      const sliders = document.querySelectorAll<HTMLInputElement>('input[type="range"]');
      sliders.forEach((slider) => {
        const badge = document.getElementById(`${slider.id}-value`);
        const unit = slider.getAttribute('data-unit') ?? '';
        slider.addEventListener('input', () => {
          if (badge) {
            badge.textContent = `${slider.value}${unit}`;
          }
        });
      });

      // 3. ColorPicker swatch <-> Hex input bidirectional sync
      const colorInputs = document.querySelectorAll<HTMLInputElement>('input[type="color"]');
      colorInputs.forEach((swatch) => {
        const hexInput = document.getElementById(`${swatch.id}-hex`) as HTMLInputElement | null;
        if (!hexInput) return;

        swatch.addEventListener('input', () => {
          hexInput.value = swatch.value.toUpperCase();
        });

        hexInput.addEventListener('input', () => {
          let val = hexInput.value.trim();
          if (!val.startsWith('#')) val = `#${val}`;
          if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
            swatch.value = val.toLowerCase();
          }
        });
      });

      // 4. Conditional sub-panels (Gradients, Custom Eye Colors, Transparent Background)
      const bindTogglePanel = (
        toggleId: string,
        panelId: string,
        displayClass: string = 'block',
        invert: boolean = false
      ) => {
        const toggle = document.getElementById(toggleId) as HTMLInputElement | null;
        const panel = document.getElementById(panelId);
        if (!toggle || !panel) return;

        const update = () => {
          const show = invert ? !toggle.checked : toggle.checked;
          panel.classList.toggle('hidden', !show);
          if (displayClass !== 'block') {
            panel.classList.toggle(displayClass, show);
          }
        };
        toggle.addEventListener('change', update);
        update();
      };

      bindTogglePanel('corners-custom-color-toggle', 'corners-custom-colors-panel', 'grid');
      bindTogglePanel('dots-gradient-toggle', 'dots-gradient-panel', 'block');
      bindTogglePanel('bg-gradient-toggle', 'bg-gradient-panel', 'block');
      bindTogglePanel('bg-transparent-toggle', 'bg-color-controls', 'block', true);

      // 5. Mobile Bottom Tab Navigation (< 1024px)
      const mainShell = document.getElementById('app-main-shell');
      const mobileNavBtns = document.querySelectorAll<HTMLButtonElement>('[data-mobile-nav-btn]');
      const setMobileTab = (tab: 'content' | 'design' | 'preview') => {
        if (!mainShell) return;
        mainShell.setAttribute('data-mobile-tab', tab);

        mobileNavBtns.forEach((btn) => {
          const isActive = btn.getAttribute('data-mobile-nav-btn') === tab;
          btn.classList.toggle('text-app-accent', isActive);
          btn.classList.toggle('text-app-muted', !isActive);
          if (isActive) {
            btn.setAttribute('aria-current', 'page');
          } else {
            btn.removeAttribute('aria-current');
          }

          const pill = btn.querySelector<HTMLElement>('.mobile-nav-pill');
          pill?.classList.toggle('bg-app-accent/15', isActive);
          pill?.classList.toggle('bg-transparent', !isActive);

          const label = btn.querySelector<HTMLElement>('span:last-child');
          label?.classList.toggle('font-semibold', isActive);
          label?.classList.toggle('font-medium', !isActive);
        });
      };

      mobileNavBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-mobile-nav-btn') as 'content' | 'design' | 'preview' | null;
          if (tab) setMobileTab(tab);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      initBaseUiInteractions();
      initPayloadController();
      initDesignController();
      void initExportAndPresetController();
    });
  </script>
</MainLayout>
