---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'ChromaQR — Pro QR Studio' } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-app-bg text-app-text antialiased h-[100dvh] w-screen overflow-hidden flex flex-col">
    <slot />
  </body>
</html>
